#!/usr/bin/env bash
# Northling: скриншоты (grim + slurp + wl-clipboard).
#   northling-screenshot area    — выделить область → буфер обмена + файл
#   northling-screenshot full    — весь экран      → буфер обмена + файл
# Папка: $NORTHLING_SHOTS_DIR или ~/Pictures/Screenshots
set -u

mode="${1:-area}"
dir="${NORTHLING_SHOTS_DIR:-$HOME/Pictures/Screenshots}"
mkdir -p "$dir" || exit 1
file="$dir/shot-$(date +%Y%m%d-%H%M%S).png"

for c in grim wl-copy; do
  command -v "$c" >/dev/null 2>&1 || { notify-send "Скриншот" "Не найден: $c" 2>/dev/null; echo "нет $c" >&2; exit 1; }
done

case "$mode" in
  area)
    command -v slurp >/dev/null 2>&1 || { echo "нет slurp" >&2; exit 1; }
    geom="$(slurp -d)" || exit 0          # Esc — отмена, без ошибок
    [ -n "$geom" ] || exit 0
    grim -g "$geom" "$file" || exit 1
    ;;
  full)
    grim "$file" || exit 1
    ;;
  *)
    echo "использование: $0 area|full" >&2; exit 2
    ;;
esac

wl-copy < "$file"
command -v notify-send >/dev/null 2>&1 && notify-send -i "$file" "Скриншот сохранён" "$file (и в буфере обмена)"
