#!/usr/bin/env bash
# «Пуск» Northling: northling-start [apps|store|clip|binds|settings|power]. Повторный вызов закрывает меню.
D="$HOME/.local/share/northling/widgets"
pkill -f northling_start.py 2>/dev/null; sleep 0.15  # старый экземпляр (даже зависший) убираем — иначе окно не открывалось
[ -f "$D/northling_start.py" ] || { echo "«Пуск» не установлен (northling update)"; exit 1; }
python3 -c "import gi; gi.require_version('GtkLayerShell','0.1')" 2>/dev/null \
  || { command -v notify-send >/dev/null && notify-send "Пуск" "Нет gtk-layer-shell: northling update --full (из TTY)"; echo "нет gtk-layer-shell"; exit 1; }
pre=""; for l in /usr/lib/libgtk-layer-shell.so /usr/lib64/libgtk-layer-shell.so /usr/lib/x86_64-linux-gnu/libgtk-layer-shell.so; do [ -e "$l" ] && { pre="$l"; break; }; done
LD_PRELOAD="$pre${LD_PRELOAD:+:$LD_PRELOAD}" setsid -f python3 "$D/northling_start.py" "${1:-apps}" >"${XDG_RUNTIME_DIR:-/tmp}/northling-start.log" 2>&1 </dev/null
