#!/usr/bin/env bash
# northling — единая команда управления Northling Arch.
#   northling update      обновить дизайн и конфиги (быстро; --full — ещё система, из TTY)
#   northling widgets     виджеты рабочего стола: start|stop|restart|config
#   northling snapshot    снимки системы (Timeshift)
#   northling gamemode    игровой режим on|off
#   northling control     центр управления (Super+A)
#   northling glass       режим Liquid Glass on|off
#   northling start       «Пуск»: поиск, бинды, настройки (Super+R)
#   northling sddm        тема экрана входа: test|enable|disable
#   northling doctor      проверить, что всё работает
#   northling wallpaper   выбрать обои
#   northling install     запустить установщик заново (безопасно)
#   northling uninstall   удалить конфиги проекта (вернёт твои прежние из бэкапа)
#   northling diag        диагностика системы (только чтение)
#   northling version | path
conf="${XDG_CONFIG_HOME:-$HOME/.config}/northling"
repo="$(cat "$conf/repo-path" 2>/dev/null)"
here="$(dirname "$(readlink -f "$0")")"
if [ ! -d "$repo" ]; then
  echo "Не найдена папка проекта Northling Arch (записана в $conf/repo-path)." >&2
  echo "Зайди в папку проекта и запусти:  bash install.sh" >&2
  exit 1
fi
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  install)           exec bash "$repo/install.sh" "$@" ;;
  update|upgrade)    exec bash "$repo/update.sh" "$@" ;;
  uninstall)         exec bash "$repo/uninstall.sh" "$@" ;;
  doctor|check)      exec bash "$repo/installer/verify.sh" "$@" ;;
  wallpaper|wall)    [ $# -eq 0 ] && set -- --menu; exec "$here/northling-wallpaper" "$@" ;;
  widgets)           exec "$here/northling-widgets" "$@" ;;
  start)             exec "$here/northling-start" "$@" ;;
  snapshot|snap)     exec "$here/northling-snapshot" "$@" ;;
  gamemode|game)     exec "$here/northling-gamemode" "$@" ;;
  control|cc)        exec "$here/northling-control" "$@" ;;
  glass)             exec "$here/northling-glass" "$@" ;;
  dock)              exec "$here/northling-dock" "$@" ;;
  sddm)              exec bash "$repo/installer/sddm.sh" "$@" ;;
  diag)              exec bash "$here/northling-diag" "$@" ;;
  version|-v)        echo "Northling Arch $(cat "$repo/VERSION")" ;;
  path)              echo "$repo" ;;
  *)                 sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
