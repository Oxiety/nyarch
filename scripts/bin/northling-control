#!/usr/bin/env bash
# Центр управления Northling (Super+A). Повторный вызов закрывает.
D="$HOME/.local/share/northling/widgets"
pkill -f northling_control.py 2>/dev/null; sleep 0.15  # старый экземпляр (даже зависший) убираем — иначе окно не открывалось
[ -f "$D/northling_control.py" ] || { echo "не установлено (northling update)"; exit 1; }
python3 -c "import gi; gi.require_version('GtkLayerShell','0.1')" 2>/dev/null || { echo "нет gtk-layer-shell: northling update --full (из TTY)"; exit 1; }
pre=""; for l in /usr/lib/libgtk-layer-shell.so /usr/lib64/libgtk-layer-shell.so /usr/lib/x86_64-linux-gnu/libgtk-layer-shell.so; do [ -e "$l" ] && { pre="$l"; break; }; done
LD_PRELOAD="$pre${LD_PRELOAD:+:$LD_PRELOAD}" setsid -f python3 "$D/northling_control.py" >"${XDG_RUNTIME_DIR:-/tmp}/northling-control.log" 2>&1 </dev/null
