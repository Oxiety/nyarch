# Northling Midnight — единый источник палитры (v0.1.0)
# Снято с northling.space (скриншот) + согласовано с ТЗ. Формат: HEX без «#».
# Эти же значения дублируются в dotfiles/hypr/hyprland.lua (блок C) —
# при смене палитры правь оба места (в v0.2 генерацию из этого файла автоматизируем).

# Фон (глубокий индиго вместо чисто-чёрного: так же, как на сайте)
BG_DEEP=0E0A24      # самый тёмный фон / экран блокировки
BG_BASE=1C1155      # основной фон панелей (с сайта: #1C1155)
BG_SURFACE=342676   # «окна» и карточки (с сайта: #342676)
SELECTION=34304F    # выделение (из ТЗ)

# Акценты
LAVENDER=A78BFA     # главный акцент (сайт: #A58FF8 / #AC74FB)
SKY=82BFFF          # второй акцент (сайт: #6DBEF8)
PINK=D284E5         # редкий третий акцент: бейджи, искры (сайт: #D284E5)

# Текст
TEXT=E5E7F5
TEXT_DIM=9E94CD     # вторичный текст (с сайта)
TEXT_ON_LIGHT=0E0A24  # тёмный текст на светлых сегментах (prompt, кнопки)
