        "input.placeholderForeground": "#6B6499",
        "inputOption.activeBorder": "#A78BFA",
        "dropdown.background": "#14102F",
        "dropdown.border": "#34304F",
        "button.background": "#A78BFA",
        "button.foreground": "#0E0A24",
        "button.hoverBackground": "#B9A2FB",
        "button.secondaryBackground": "#34304F",
        "button.secondaryForeground": "#E5E7F5",
        "badge.background": "#A78BFA",
        "badge.foreground": "#0E0A24",
        "progressBar.background": "#A78BFA",
        "scrollbarSlider.background": "#34304F88",
        "scrollbarSlider.hoverBackground": "#4A4580AA",
        "scrollbarSlider.activeBackground": "#A78BFA88",
        "textLink.foreground": "#82BFFF",
        "textLink.activeForeground": "#A9D4FF",
        "peekViewEditor.background": "#110C2B",
        "peekViewResult.background": "#14102F",
        "peekViewTitle.background": "#14102F",
        "menu.background": "#14102F",
        "menu.selectionBackground": "#34304F",
        "notifications.background": "#14102F",
        "notifications.border": "#34304F",
        "breadcrumb.foreground": "#9E94CD",
        "breadcrumb.focusForeground": "#E5E7F5",

        "gitDecoration.addedResourceForeground": "#7FE0B0",
        "gitDecoration.modifiedResourceForeground": "#82BFFF",
        "gitDecoration.deletedResourceForeground": "#F27A9C",
        "gitDecoration.untrackedResourceForeground": "#D284E5",
        "gitDecoration.ignoredResourceForeground": "#6B6499",
        "gitDecoration.conflictingResourceForeground": "#F2D479",

        "terminal.background": "#0E0A24",
        "terminal.foreground": "#E5E7F5",
        "terminalCursor.foreground": "#A78BFA",
        "terminal.selectionBackground": "#34304F",
        "terminal.ansiBlack": "#1C1740",
        "terminal.ansiBrightBlack": "#4A4580",
        "terminal.ansiRed": "#F27A9C",
        "terminal.ansiBrightRed": "#FF9FB7",
        "terminal.ansiGreen": "#7FE0B0",
        "terminal.ansiBrightGreen": "#A0F0C8",
        "terminal.ansiYellow": "#F2D479",
        "terminal.ansiBrightYellow": "#FFE7A1",
        "terminal.ansiBlue": "#82BFFF",
        "terminal.ansiBrightBlue": "#A9D4FF",
        "terminal.ansiMagenta": "#A78BFA",
        "terminal.ansiBrightMagenta": "#C4B0FF",
        "terminal.ansiCyan": "#6FD8E8",
        "terminal.ansiBrightCyan": "#9AE8F2",
        "terminal.ansiWhite": "#CFD0E8",
        "terminal.ansiBrightWhite": "#FFFFFF"
    },
    "tokenColors": [
        { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6B6499", "fontStyle": "italic" } },
        { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#A78BFA" } },
        { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#C4B8F5" } },
        { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#7FE0B0" } },
        { "scope": ["constant.numeric", "constant.language", "constant.character.escape"], "settings": { "foreground": "#D284E5" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#82BFFF" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#9AE8F2" } },
        { "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#E5E7F5" } },
        { "scope": ["variable.parameter"], "settings": { "foreground": "#F2D479", "fontStyle": "italic" } },
        { "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#C4B0FF" } },
        { "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#A78BFA" } },
        { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#82BFFF" } },
        { "scope": ["support.constant", "variable.language"], "settings": { "foreground": "#F27A9C" } },
        { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#A78BFA", "fontStyle": "bold" } },
        { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#7FE0B0" } },
        { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#82BFFF" } },
        { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#F27A9C" } }
    ]
}
