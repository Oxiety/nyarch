        "list.highlightForeground": "#82BFFF",
        "list.focusOutline": "#A78BFA",

        "titleBar.activeBackground": "#0A071C",
        "titleBar.activeForeground": "#C4B8F5",
        "titleBar.inactiveBackground": "#0A071C",
        "titleBar.inactiveForeground": "#6B6499",
        "titleBar.border": "#1C1155",

        "tab.activeBackground": "#0E0A24",
        "tab.activeForeground": "#E5E7F5",
        "tab.activeBorderTop": "#A78BFA",
        "tab.inactiveBackground": "#0A071C",
        "tab.inactiveForeground": "#6B6499",
        "tab.border": "#1C1155",
        "tab.hoverBackground": "#14102F",
