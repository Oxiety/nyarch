{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 14,
    "margin-right": 14,
    "spacing": 6,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/notification", "hyprland/language", "pulseaudio", "cpu", "memory", "custom/gpu", "network", "tray", "custom/power"],

    "custom/launcher": {
        "format": "◆ northling",
        "tooltip": false,
        "on-click": "rofi -show drun",
        "on-click-right": "~/.local/bin/northling-wallpaper --menu"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 48,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%a, %d %b  ·  %H:%M}",
        "format-alt": "{:%A, %d %B %Y  ·  %H:%M:%S}",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#A78BFA'><b>{}</b></span>"
            }
        }
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "◉",
            "none": "○",
            "dnd-notification": "⊘",
            "dnd-none": "⊘",
            "inhibited-notification": "◉",
            "inhibited-none": "○",
            "dnd-inhibited-notification": "⊘",
            "dnd-inhibited-none": "⊘"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "hyprland/language": {
        "format": "{short}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    "pulseaudio": {
        "format": "<span color='#9E94CD'>vol</span> {volume}%",
        "format-muted": "<span color='#F27A9C'>mute</span>",
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": false
    },

    "cpu": {
        "interval": 3,
        "format": "<span color='#9E94CD'>cpu</span> {usage}%",
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "<span color='#9E94CD'>ram</span> {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "interval": 5,
        "format": "{}",
        "tooltip": false
    },

    "network": {
        "interval": 5,
        "format-wifi": "<span color='#9E94CD'>wifi</span> {signalStrength}%",
        "format-ethernet": "<span color='#9E94CD'>net</span> up",
        "format-disconnected": "<span color='#F27A9C'>offline</span>",
        "tooltip-format": "{ifname}  {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "tray": {
        "spacing": 10
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power.sh"
    }
}
