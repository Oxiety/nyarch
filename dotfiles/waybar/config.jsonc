{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 10,
    "margin-left": 16,
    "margin-right": 16,
    "spacing": 10,
    "reload_style_on_change": true,

    "modules-left":   ["custom/logo", "hyprland/workspaces", "custom/player"],
    "modules-center": ["custom/clock"],
    "modules-right":  ["group/sys", "group/io", "tray", "custom/notification", "custom/power"],

    "custom/logo": {
        "format": "n.",
        "tooltip": false,
        "on-click": "rofi -show drun",
        "on-click-right": "~/.local/bin/northling-wallpaper --menu"
    },

    "hyprland/workspaces": {
        "format": "",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1",
        "persistent-workspaces": { "*": 5 }
    },

    "custom/player": {
        "exec": "~/.config/waybar/scripts/player.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    "custom/clock": {
        "exec": "python3 ~/.config/waybar/scripts/clock.py",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "tooltip": true,
        "on-click": "~/.config/waybar/scripts/clock-toggle.sh"
    },

    "group/sys": {
        "orientation": "horizontal",
        "modules": ["custom/cpu", "custom/mem", "custom/gpu"]
    },
    "custom/cpu": { "exec": "~/.config/waybar/scripts/stat.sh cpu", "return-type": "json", "interval": 2, "on-click": "kitty -e btop" },
    "custom/mem": { "exec": "~/.config/waybar/scripts/stat.sh mem", "return-type": "json", "interval": 4, "on-click": "kitty -e btop" },
    "custom/gpu": { "exec": "~/.config/waybar/scripts/stat.sh gpu", "return-type": "json", "interval": 3, "on-click": "kitty -e btop" },

    "group/io": {
        "orientation": "horizontal",
        "modules": ["network", "pulseaudio", "custom/lang"]
    },

    "network": {
        "interval": 3,
        "format-wifi": "● {essid}",
        "format-ethernet": "● Интернет ({bandwidthDownBytes})",
        "format-disconnected": "○ offline",
        "tooltip-format": "Интернет {ipaddr}\n↓ {bandwidthDownBytes} ↑ {bandwidthUpBytes}",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "♪ {volume}",
        "format-muted": "♪ ✕",
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": false
    },

    "custom/lang": {
        "exec": "~/.config/waybar/scripts/lang.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "hyprctl switchxkblayout all next"
    },

    "tray": { "spacing": 10 },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "◉",
            "none": "○",
            "dnd-notification": "⊘",
            "dnd-none": "⊘",
            "inhibited-notification": "◉",
            "inhibited-none": "○",
            "dnd-inhibited-notification": "⊘",
            "dnd-inhibited-none": "⊘"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power.sh"
    }
}
